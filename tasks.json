{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "process",
            "label": "west configure",
            "command": "cmd",
            "args": [
                "/d",
                "/c",
                "start",
                "app gdbserver",
                "powershell",
                "-NoExit",
                "-Command",
                ". 'E:/zephyr/.venv/Scripts/Activate.ps1'"
            ],
            "problemMatcher": []
        },
        {
            "type": "shell",
            "label": "build app",
            "command": "E:/zephyr/.venv/Scripts/Activate.ps1;cd E:/zephyr/zephyrproject/;west build -d ./build_app",
            "problemMatcher": []
        },
        {
            "type": "shell",
            "label": "build bootloader",
            "command": "E:/zephyr/.venv/Scripts/Activate.ps1;cd E:/zephyr/zephyrproject/;west build -d ./build_boot"
        },
        {
            "type": "shell",
            "label": "flash app",
            "command": "E:/zephyr/.venv/Scripts/Activate.ps1;cd E:/zephyr/zephyrproject/;west flash -d ./build_app"
        },
        {
            "type": "shell",
            "label": "flash bootloader",
            "command": "E:/zephyr/.venv/Scripts/Activate.ps1;cd E:/zephyr/zephyrproject/;west flash -d ./build_boot"
        },
        {
            "type": "process",
            "label": "start gdbserver with reset bootloader",
            "command": "cmd",
            "args": [
                "/d",
                "/c",
                "start",
                "boot gdbserver",
                "powershell",
                "-Command",
                "ST-LINK_gdbserver --stm32cubeprogrammer-path 'C:/ST/STM32CubeCLT_1.22.0/STM32CubeProgrammer/bin' --port-number 61234 --apid 0 --halt --swd --initialize-reset --shared --frequency 200"
            ],
            "dependsOn": [
                "build bootloader"
            ],
            "problemMatcher": []
        },
        {
            "type": "process",
            "label": "start gdbserver no reset bootloader",
            "command": "cmd",
            "args": [
                "/d",
                "/c",
                "start",
                "boot gdbserver",
                "powershell",
                "-Command",
                "ST-LINK_gdbserver --stm32cubeprogrammer-path 'C:/ST/STM32CubeCLT_1.22.0/STM32CubeProgrammer/bin' --port-number 61234 --apid 0 --swd -g --shared --frequency 200"
            ],
            "dependsOn": [
                "build bootloader"
            ],
            "problemMatcher": []
        },
        {
            "type": "process",
            "label": "start gdbserver with reset app",
            "command": "cmd",
            "args": [
                "/d",
                "/c",
                "start",
                "boot gdbserver",
                "powershell",
                "-Command",
                "ST-LINK_gdbserver --stm32cubeprogrammer-path 'C:/ST/STM32CubeCLT_1.22.0/STM32CubeProgrammer/bin' --port-number 61234 --apid 0 --halt --swd --initialize-reset --shared --frequency 200"
            ],
            "dependsOn": [
                "build app"
            ],
            "problemMatcher": []
        },
        {
            "type": "process",
            "label": "start gdbserver no reset app",
            "command": "cmd",
            "args": [
                "/d",
                "/c",
                "start",
                "boot gdbserver",
                "powershell",
                "-Command",
                "ST-LINK_gdbserver --stm32cubeprogrammer-path 'C:/ST/STM32CubeCLT_1.22.0/STM32CubeProgrammer/bin' --port-number 61234 --apid 0 --swd -g --shared --frequency 200"
            ],
            "dependsOn": [
                "build app"
            ],
            "problemMatcher": []
        }
    ]
}